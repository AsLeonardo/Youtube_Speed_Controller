{
  "manifest_version": 3,
  "name": "YouTube Speed Controller",
  "version": "3.0.2",
  "description": "Toggle and adjust YouTube playback speed (0.5x – 2.0x) from a popup in the toolbar.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "YouTube Speed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "exclude_matches": ["*://music.youtube.com/*"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
